#!/bin/sh
# SirrOS: regenerate the LUKS2 volume key on first boot (online re-encryption).
#
# WHY
#   Release images are encrypted at build time, so every flashed device shares
#   the same volume key. Changing the passphrase only re-wraps that key. LUKS2
#   supports ONLINE re-encryption, so this re-encrypts the mounted root device
#   in the background with a freshly generated volume key.
#
# CALLED BY
#   sirros-rekey-after-login (via sirros-rekey.service), after the first login.
#
# CREDENTIALS
#   The public factory passphrase, used automatically and invisibly.
#   --passfile FILE overrides it (manual runs, or after the passphrase was
#   changed before this ran).
#
# LOG
#   Everything (including every line cryptsetup prints, with progress every
#   SIRROS_PROGRESS_FREQ seconds) goes to $LOG, default /var/lib/sirros/rekey.log
#   (persistent, readable without root), and to stdout, which systemd sends to
#   the journal. No secret is ever logged.
#
# LIMITS
#   * This replaces the VOLUME KEY only; the keyslot keeps whatever passphrase
#     unlocked it.
#   * Data written before this finishes ends up under the new key, but flash
#     wear-leveling may keep stale copies encrypted with the old (public) key.
#
# Usage: sirros-rekey [--passfile FILE]

set -u

FACTORY_PASS="s1rr0s"      # must match the passphrase used at build time
NAME="root"                # dm-crypt mapping name (see /etc/crypttab)

# Overridable only for tests outside a real device.
STATE="${SIRROS_STATE:-/var/lib/sirros}"
LOG="${SIRROS_LOG:-$STATE/rekey.log}"
WORK="${SIRROS_WORK:-/run/sirros-rekey}"
PROGRESS_FREQ="${SIRROS_PROGRESS_FREQ:-60}"   # seconds between progress lines

DONE="$STATE/rekey.done"
umask 077
mkdir -p "$STATE" "$WORK"
# The state dir and log hold no secret (the passphrase only ever lives in
# $WORK, under /run); make them readable so the log can be read without root.
chmod 0755 "$STATE" 2>/dev/null
[ -e "$LOG" ] || : > "$LOG"
chmod 0644 "$LOG" 2>/dev/null

log() {
    line="$(date '+%F %T %z') [rekey] $*"
    printf '%s\n' "$line" >> "$LOG" 2>/dev/null
    printf '%s\n' "$line"
}

T0=$(date +%s)
STOPPING=0
# shellcheck disable=SC2329  # called by the EXIT trap
on_exit() {
    rc=$?
    rm -rf "$WORK"
    log "exit code $rc after $(( $(date +%s) - T0 ))s"
}
trap on_exit EXIT
# On shutdown systemd sends SIGTERM to cryptsetup too; cryptsetup then writes
# its progress to the LUKS header and stops, and the next run resumes. This
# shell only notes it here (the trap runs once cryptsetup has returned).
trap 'STOPPING=1; log "signal received (shutdown?); cryptsetup saves its progress and stops"' TERM INT HUP

# run_logged TAG CMD...  Run CMD, prefix every output line (stdout+stderr) with
# a timestamp and TAG into the log, return CMD's exit code. The reader ignores
# TERM/INT so cryptsetup never dies of SIGPIPE while stopping cleanly.
run_logged() {
    tag=$1; shift
    rcf="$WORK/rc.$$"
    echo 255 > "$rcf"
    # The writer side catches (not ignores) TERM, so cryptsetup still gets the
    # default handling but its exit code is recorded even during shutdown.
    { trap : TERM INT HUP; "$@" 2>&1; echo $? > "$rcf"; } | (
        trap '' TERM INT HUP
        # No "tr"/"sed" here: they buffer, and progress lines would arrive late.
        cr=$(printf '\r')
        while IFS= read -r l; do
            l=${l%"$cr"}; l=${l##*"$cr"}
            [ -n "$l" ] && log "$tag: $l"
        done
    )
    r=$(cat "$rcf" 2>/dev/null); rm -f "$rcf"
    return "${r:-255}"
}

PASSFILE=""
if [ "${1:-}" = "--passfile" ]; then PASSFILE="${2:-}"; fi

log "---- sirros-rekey start (pid $$, uid $(id -u)) ----"
if [ -e "$DONE" ]; then log "already done ($(cat "$DONE" 2>/dev/null)), nothing to do"; exit 0; fi
log "kernel $(uname -r), $(cryptsetup --version 2>/dev/null || echo 'cryptsetup not found')"

# 1. Backing device of the unlocked root mapping.
if [ -n "${SIRROS_DEV:-}" ]; then
    DEV="$SIRROS_DEV"
else
    DEV=$(cryptsetup status "$NAME" 2>/dev/null | sed -n 's/^[[:space:]]*device:[[:space:]]*//p')
    [ -b "$DEV" ] || { log "ERROR: cannot find backing device of /dev/mapper/$NAME"; exit 1; }
fi
log "backing device: $DEV"

# 2. LUKS2 only (LUKS1 has no online re-encryption).
if ! cryptsetup luksDump "$DEV" 2>/dev/null | grep -q '^Version:[[:space:]]*2'; then
    log "ERROR: $DEV is not LUKS2"; exit 1
fi
# Non-secret header summary, handy when reading the log later.
cryptsetup luksDump "$DEV" 2>/dev/null \
    | grep -E '^[[:space:]]*(Version|cipher|Requirements|[0-9]+: luks2|Keyslots|Data segments|offset|length)' \
    | while IFS= read -r l; do log "header: $l"; done

# 3. Credentials.
if [ -n "$PASSFILE" ]; then
    KF="$PASSFILE"
    log "credentials: --passfile $PASSFILE"
else
    printf '%s' "$FACTORY_PASS" > "$WORK/key"
    KF="$WORK/key"
    log "credentials: factory passphrase"
fi
if ! run_logged "test-passphrase" cryptsetup open --test-passphrase --key-file "$KF" "$DEV"; then
    log "ERROR: the passphrase does not unlock the volume (was it changed before the re-key ran?). Re-run manually with --passfile FILE"
    exit 2
fi
log "passphrase OK"

# Fingerprint of the key digest (header metadata, not a secret). A different
# value after the run proves a new volume key was generated.
digest() {
    cryptsetup luksDump "$DEV" 2>/dev/null | sed -n '/^Digests:/,$p' | sha256sum | cut -c1-16
}
[ -e "$STATE/digest.before" ] || digest > "$STATE/digest.before"
log "key digest fingerprint before: $(cat "$STATE/digest.before")"

# 4. Fresh run or resume of an interrupted one.
if cryptsetup luksDump "$DEV" 2>/dev/null | grep -q 'online-reencrypt'; then
    MODE="resume"
else
    MODE="fresh"
fi
log "mode: $MODE"

# Optional cryptsetup features, used only when this version has them.
help=$(cryptsetup reencrypt --help 2>&1)
OPTS=""
case "$help" in *--active-name*) OPTS="$OPTS --active-name $NAME" ;; esac
case "$help" in *--progress-frequency*) OPTS="$OPTS --progress-frequency $PROGRESS_FREQ" ;; esac
log "extra options:${OPTS:- none}"

log "re-encrypting (this takes a while; the system stays usable)"
RT0=$(date +%s)
if [ "$MODE" = "resume" ]; then
    # shellcheck disable=SC2086
    run_logged "cryptsetup" cryptsetup reencrypt --resume-only --batch-mode $OPTS \
        --key-file "$KF" "$DEV"
else
    # No --keep-key: that is what generates a NEW volume key.
    # shellcheck disable=SC2086
    run_logged "cryptsetup" cryptsetup reencrypt --batch-mode --use-random $OPTS \
        --cipher aes-xts-plain64 --key-size 512 --hash sha512 \
        --resilience checksum \
        --key-file "$KF" "$DEV"
fi
rc=$?
log "cryptsetup reencrypt exit code: $rc after $(( $(date +%s) - RT0 ))s"
if [ "$rc" -ne 0 ]; then
    if [ "$STOPPING" = 1 ]; then
        log "stopped by a signal; it will resume on the next run"
    else
        log "ERROR: re-encryption did not finish (failed or interrupted); it will resume on the next run"
    fi
    exit 1
fi

# 5. Verify that the volume key really changed.
before=$(cat "$STATE/digest.before")
after=$(digest)
log "key digest fingerprint: $before -> $after"
if [ "$before" = "$after" ]; then
    log "ERROR: digest unchanged, volume key was NOT regenerated"
    exit 1
fi

sync
echo "volume key regenerated $(date -u +%FT%TZ)" > "$DONE"
chmod 0644 "$DONE" 2>/dev/null
log "OK: volume key regenerated"
exit 0
